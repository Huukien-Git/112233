; AutoCAD Script file ve luoi truc 123 va ABC
; Keo tha file nay truc tiep vao man hinh AutoCAD hoac go lenh SCRIPT
CMDECHO 0
OSMODE 0

; Tao va thiet lap Layer
-LAYER M TRUC C 1 TRUC 
-LAYER M BONG_BONG C 2 BONG_BONG 
-LAYER M TEXT_TRUC C 3 TEXT_TRUC 
-LAYER M DIM C 4 DIM 

; Ve duong truc doc (Layer TRUC)
CLAYER TRUC
LINE 0,-1200 0,9200 
LINE 4000,-1200 4000,9200 
LINE 8500,-1200 8500,9200 

; Ve duong truc ngang (Layer TRUC)
LINE -1200,0 9700,0 
LINE -1200,4000 9700,4000 
LINE -1200,8000 9700,8000 

; Ve bong bong truc (Layer BONG_BONG)
CLAYER BONG_BONG
CIRCLE 0,-1650 450
CIRCLE 4000,-1650 450
CIRCLE 8500,-1650 450

CIRCLE 0,9650 450
CIRCLE 4000,9650 450
CIRCLE 8500,9650 450

CIRCLE -1650,0 450
CIRCLE -1650,4000 450
CIRCLE -1650,8000 450

CIRCLE 10150,0 450
CIRCLE 10150,4000 450
CIRCLE 10150,8000 450

; Ghi chu ten truc (Layer TEXT_TRUC)
CLAYER TEXT_TRUC
-TEXT J MC 0,-1650 400 0 1
-TEXT J MC 4000,-1650 400 0 2
-TEXT J MC 8500,-1650 400 0 3

-TEXT J MC 0,9650 400 0 1
-TEXT J MC 4000,9650 400 0 2
-TEXT J MC 8500,9650 400 0 3

-TEXT J MC -1650,0 400 0 A
-TEXT J MC -1650,4000 400 0 B
-TEXT J MC -1650,8000 400 0 C

-TEXT J MC 10150,0 400 0 A
-TEXT J MC 10150,4000 400 0 B
-TEXT J MC 10150,8000 400 0 C

; Ghi kich thuoc (Layer DIM)
CLAYER DIM
DIMLINEAR 0,0 4000,0 2000,-700
DIMLINEAR 4000,0 8500,0 6250,-700
DIMLINEAR 0,0 8500,0 4250,-2700

DIMLINEAR 0,0 0,4000 -700,2000
DIMLINEAR 0,4000 0,8000 -700,6000
DIMLINEAR 0,0 0,8000 -2700,4000

; Tieu de ban ve
CLAYER TEXT_TRUC
-TEXT J MC 4250,-3900 450 0 MAT BANG HE TRUC TOA DO
LINE 2050,-4250 6450,-4250 
CLAYER DIM
-TEXT J MC 4250,-4550 250 0 TY LE: 1/100

; Bat lai bat diem va zoom toan bo
OSMODE 111
ZOOM E
